@@ -0,0 +1,29 @@
+package com.example.ui.model
+
+/**
+ * The quality label for a picture, from its shorter side so it reads the same upright or sideways:
+ * 720 and up is "HD", 1080 "FHD", 1440 "2K", 2160 "4K". Smaller pictures get no label.
+ */
+fun qualityBadge(width: Int, height: Int): String? {
+    val shortSide = minOf(width, height)
+    return when {
+        shortSide <= 0 -> null
+        shortSide >= 2160 -> "4K"
+        shortSide >= 1440 -> "2K"
+        shortSide >= 1080 -> "FHD"
+        shortSide >= 720 -> "HD"
+        else -> null
+    }
+}
+
+/** "720×1280" for a tile, or "Unknown" when the size is not known. */
+fun formatResolutionShort(width: Int, height: Int): String =
+    if (width > 0 && height > 0) "$width\u00D7$height" else "Unknown"
+
+/** "Portrait", "Landscape" or "Square". */
+fun orientationName(width: Int, height: Int): String = when {
+    width <= 0 || height <= 0 -> "Unknown"
+    width > height -> "Landscape"
+    width < height -> "Portrait"
+    else -> "Square"
+}
