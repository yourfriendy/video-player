+package com.example.data.repository
+
+import java.util.Locale
+
+/**
+ * Plain names for what the phone's media tools report: "video/avc" becomes "H.264", "audio/mp4a-latm" becomes "AAC",
+ * 2 channels become "Stereo". Pure text, so it can be tested without a phone.
+ */
+object CodecNames {
+
+    /** "H.264", "H.265 (HEVC)", "VP9", "AV1"... or "Unknown" when there is no track information. */
+    fun videoCodec(mime: String?): String {
+        if (mime.isNullOrBlank()) return "Unknown"
+        return when (mime.lowercase(Locale.ROOT)) {
+            "video/avc" -> "H.264"
+            "video/hevc" -> "H.265 (HEVC)"
+            "video/x-vnd.on2.vp9" -> "VP9"
+            "video/x-vnd.on2.vp8" -> "VP8"
+            "video/av01" -> "AV1"
+            "video/mp4v-es" -> "MPEG-4"
+            "video/3gpp" -> "H.263"
+            "video/dolby-vision" -> "Dolby Vision"
+            "video/mpeg2" -> "MPEG-2"
+            else -> mime.substringAfter('/').uppercase(Locale.ROOT)
+        }
+    }
+
+    /** "AAC · Stereo · 44.1 kHz". Parts that are not known are left out; no audio at all gives "No audio". */
+    fun audioTrack(mime: String?, channels: Int, sampleRateHz: Int): String {
+        if (mime.isNullOrBlank()) return "No audio"
+        val codec = when (mime.lowercase(Locale.ROOT)) {
+            "audio/mp4a-latm" -> "AAC"
+            "audio/mpeg" -> "MP3"
+            "audio/opus" -> "Opus"
+            "audio/vorbis" -> "Vorbis"
+            "audio/flac" -> "FLAC"
+            "audio/ac3" -> "Dolby Digital"
+            "audio/eac3" -> "Dolby Digital Plus"
+            "audio/3gpp", "audio/amr-wb" -> "AMR"
+            "audio/raw" -> "PCM"
+            else -> mime.substringAfter('/').uppercase(Locale.ROOT)
+        }
+        val parts = mutableListOf(codec)
+        channelName(channels)?.let { parts.add(it) }
+        if (sampleRateHz > 0) parts.add(formatKilohertz(sampleRateHz))
+        return parts.joinToString(" · ")
+    }
+
+    fun channelName(channels: Int): String? = when {
+        channels <= 0 -> null
+        channels == 1 -> "Mono"
+        channels == 2 -> "Stereo"
+        channels == 6 -> "5.1 surround"
+        channels == 8 -> "7.1 surround"
+        else -> "$channels channels"
+    }
+
+    /** 44100 -> "44.1 kHz", 48000 -> "48 kHz". */
+    fun formatKilohertz(hz: Int): String {
+        val khz = hz / 1000.0
+        return if (khz == khz.toInt().toDouble()) "${khz.toInt()} kHz" else String.format(Locale.US, "%.1f kHz", khz)
+    }
+
+    /** 30.0 -> "30 fps", 29.97 -> "29.97 fps". Zero or less is "Unknown". */
+    fun frameRate(fps: Float): String = when {
+        fps <= 0f -> "Unknown"
+        kotlin.math.abs(fps - Math.round(fps)) < 0.01f -> "${Math.round(fps)} fps"
+        else -> String.format(Locale.US, "%.2f fps", fps)
+    }
+
+    /** BT.709, BT.601 or BT.2020 from MediaFormat's colour standard number; "Unknown" for anything else. */
+    fun colorStandard(value: Int): String = when (value) {
+        1 -> "BT.709"
+        2, 4 -> "BT.601"
+        6 -> "BT.2020 (wide colour)"
+        else -> "Unknown"
+    }
+}
