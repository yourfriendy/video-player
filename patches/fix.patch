+package com.example.ui
+
+import com.example.ui.model.formatResolutionShort
+import com.example.ui.model.orientationName
+import com.example.ui.model.qualityBadge
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class VideoQualityTest {
+    @Test
+    fun badgeUsesTheShorterSideSoSidewaysAndUprightAgree() {
+        assertEquals("HD", qualityBadge(720, 1280))
+        assertEquals("HD", qualityBadge(1280, 720))
+        assertEquals("FHD", qualityBadge(1080, 1920))
+        assertEquals("2K", qualityBadge(2560, 1440))
+        assertEquals("4K", qualityBadge(3840, 2160))
+    }
+
+    @Test
+    fun smallOrUnknownPicturesGetNoBadge() {
+        assertNull(qualityBadge(640, 360))
+        assertNull(qualityBadge(0, 0))
+    }
+
+    @Test
+    fun resolutionAndOrientationText() {
+        assertEquals("720\u00D71280", formatResolutionShort(720, 1280))
+        assertEquals("Unknown", formatResolutionShort(0, 1280))
+        assertEquals("Portrait", orientationName(720, 1280))
+        assertEquals("Landscape", orientationName(1920, 1080))
+        assertEquals("Square", orientationName(500, 500))
+        assertEquals("Unknown", orientationName(0, 0))
+    }
+}
