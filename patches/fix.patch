@@ -0,0 +1,43 @@
+package com.example.data.repository
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class CodecNamesTest {
+    @Test
+    fun videoCodecsGetPlainNames() {
+        assertEquals("H.264", CodecNames.videoCodec("video/avc"))
+        assertEquals("H.265 (HEVC)", CodecNames.videoCodec("video/hevc"))
+        assertEquals("VP9", CodecNames.videoCodec("video/x-vnd.on2.vp9"))
+        assertEquals("AV1", CodecNames.videoCodec("video/av01"))
+        assertEquals("FOO", CodecNames.videoCodec("video/foo"))
+        assertEquals("Unknown", CodecNames.videoCodec(null))
+        assertEquals("Unknown", CodecNames.videoCodec(" "))
+    }
+
+    @Test
+    fun audioTrackReadsCodecChannelsAndRate() {
+        assertEquals("AAC · Stereo · 44.1 kHz", CodecNames.audioTrack("audio/mp4a-latm", 2, 44100))
+        assertEquals("AAC · Mono · 48 kHz", CodecNames.audioTrack("audio/mp4a-latm", 1, 48000))
+        assertEquals("Opus · 5.1 surround", CodecNames.audioTrack("audio/opus", 6, 0))
+        assertEquals("MP3", CodecNames.audioTrack("audio/mpeg", 0, 0))
+        assertEquals("No audio", CodecNames.audioTrack(null, 2, 44100))
+    }
+
+    @Test
+    fun frameRateIsHonest() {
+        assertEquals("30 fps", CodecNames.frameRate(30f))
+        assertEquals("29.97 fps", CodecNames.frameRate(29.97f))
+        assertEquals("60 fps", CodecNames.frameRate(60.004f))
+        assertEquals("Unknown", CodecNames.frameRate(0f))
+        assertEquals("Unknown", CodecNames.frameRate(-1f))
+    }
+
+    @Test
+    fun colourStandardNames() {
+        assertEquals("BT.709", CodecNames.colorStandard(1))
+        assertEquals("BT.601", CodecNames.colorStandard(4))
+        assertEquals("BT.2020 (wide colour)", CodecNames.colorStandard(6))
+        assertEquals("Unknown", CodecNames.colorStandard(99))
+    }
+}
