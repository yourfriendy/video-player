<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. The WebView folder holds the Instagram sign-in session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
