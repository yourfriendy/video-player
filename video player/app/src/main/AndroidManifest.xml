<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The optional OffScroll Engine app (yt-dlp, about 50 MB) does the "Any link" downloads. Only apps signed with
        the same key may use it; both apps declare this same permission so install order doesn't matter.
    -->
    <permission
        android:name="com.aistudio.offscroll.permission.USE_ENGINE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.aistudio.offscroll.permission.USE_ENGINE" />

    <!-- Android 11+: lets OffScroll see whether the engine app is installed -->
    <queries>
        <package android:name="com.aistudio.offscroll.engine" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the user exempt OffScroll from battery optimisation so story alerts keep running when the app is closed -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app updates: lets OffScroll hand a downloaded OffScroll.apk to Android's installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Any link" downloads: keep a long download alive (and show its progress) while the app is in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Music player: keeps music playing (with a notification and lock-screen controls) when the app is in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Live story alerts (timers of 10 minutes or less) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Music player: reads the music files on the phone (Android 13+). Older versions use READ_EXTERNAL_STORAGE below -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".OffScrollApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        
            <!-- Deep links: offscroll://alerts and offscroll://person/<instagram username> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="offscroll" android:host="alerts" />
                <data android:scheme="offscroll" android:host="person" />
            </intent-filter>
        </activity>
        <!--
            "Open with": what Android offers when another app (Files, Gallery, WhatsApp, a browser...) wants to
            play a video. Without a VIEW + video/* filter an app never appears in that list. It plays the single
            video it is handed, so it is a separate screen from the feed (see ExternalVideoActivity).
        -->
        <activity
            android:name=".ExternalVideoActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <!-- A video file from this phone, with its type known (the usual case) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- A link to a video file, e.g. tapped in a browser -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Some file managers send no type at all, only the file name, so also match common video extensions -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.avi" />
            </intent-filter>
        </activity>
        <!--
            Share sheet target: a small pop-up over the app you shared from (Instagram, YouTube, ...) that
            downloads the link, so you never have to switch apps. Stories and anything that needs the full
            app are handed over to MainActivity.
        -->
        <activity
            android:name=".ShareDownloadActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.MyApplication.SharePopup">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Instagram's own sign-in page (used for the Stories tab) -->
        <activity
            android:name=".IgLoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <!-- Music player: plays in the background with a media notification, lock-screen and Bluetooth controls -->
        <service
            android:name=".service.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.DownloadKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serves the downloaded update APK (from the private cache) to Android's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Live story alerts: a short timer (1-10 min) keeps a small ongoing notification so Android doesn't pause the checks -->
        <service
            android:name=".data.download.StoryWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Checks the Instagram people the user chose for new stories and reposts on a timer the user sets" />
        </service>
    </application>

</manifest>
